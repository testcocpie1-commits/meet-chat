PORT=3000
# 正式使用前设置至少 16 个字符的随机密码。留空则后台无法登录。
ADMIN_PASSWORD=
# HTTPS 部署必须设置 true；本地 HTTP 开发使用 false。
COOKIE_SECURE=false
# 部署在 Nginx / Caddy 等单层反向代理后设为 true，使用代理追加的 X-Forwarded-For 识别真实 IP。
# 未经代理直接对外时必须保持 false，否则客户端可伪造 IP。
TRUST_PROXY=false
# 无操作多久后清除会话（分钟），默认 60。超过 90 秒未连线的用户会显示为“暂时离开”，并跳过配对。
SESSION_TIMEOUT_MINUTES=60
# 从 Google AdSense 获取；两者均配置后才加载广告。
ADSENSE_CLIENT=
ADSENSE_SLOT=
